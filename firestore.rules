rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/learners/{learnerId} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['nickname'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 40;
      match /completions/{completionId} {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && exists(/databases/$(database)/documents/users/$(uid)/learners/$(learnerId))
          && completionId.matches('^[a-f0-9]{64}$')
          && request.resource.data.keys().hasOnly(['completed'])
          && request.resource.data.completed == true;
      }
    }
    match /users/{uid}/settings/curriculum {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['json'])
        && request.resource.data.json is string
        && request.resource.data.json.size() <= 700000;
    }
    // All other paths and all client deletions are denied by default.
  }
}
